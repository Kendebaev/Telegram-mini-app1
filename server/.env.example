# Server HTTP Port (Local development)
PORT=3001

# PostgreSQL Database Connection String (Prisma)
# Examples:
# Neon (Serverless Postgres):
# DATABASE_URL="postgresql://neondb_owner:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Supabase:
# DATABASE_URL="postgresql://postgres.abcdefgh:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Vercel Postgres:
# DATABASE_URL="postgres://default:password@ep-xyz-123456.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Telegram Bot Token from @BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# If set, HMAC signature verification of Telegram initData is enforced.
# If omitted or left as "demo_bot_token_replace_with_real", runs in demo fallback mode.
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"

# Telegram WebApp HTTPS Production URL (deployed on Vercel)
# e.g., https://your-expense-tracker.vercel.app
WEBAPP_URL="https://your-app.vercel.app"
