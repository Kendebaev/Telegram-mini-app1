# ========================================================
# ENVIRONMENT VARIABLES FOR VERCEL & LOCAL DEVELOPMENT
# ========================================================

# 1. DATABASE_URL (Required for Prisma ORM & Postgres)
# Obtain this from Neon (https://neon.tech), Supabase (https://supabase.com), or Vercel Postgres.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# 2. TELEGRAM_BOT_TOKEN (Required for HMAC initData verification & Bot notifications)
# Obtain this from @BotFather on Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# In production on Vercel, set this in: Project Settings -> Environment Variables
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"

# 3. WEBAPP_URL (Required for Telegram WebApp Bot menu/inline buttons)
# The public HTTPS URL provided by Vercel
WEBAPP_URL="https://your-app.vercel.app"

# 4. Optional Frontend API Override (Vite)
# Leave empty on Vercel so the frontend uses relative '/api' paths automatically.
# VITE_API_URL=
